    "version": "0.1.0",
    "author": "Open World Prototype",
    "compatibilityLineage": ["tokyo-kanagawa-world", "JP_TOKYO_KANAGAWA_MAINLAND"]
  },
  "tileViews": {
    "catalog": "geography/tile-views.json",
    "initialTileId": "JP_TOKYO_MAINLAND",
    "boundaryOverlay": "geography/world-boundary-overlay.json"
  },
  "map": {
    "sourceLock": "sources.lock.json",
    "profile": "osm-depot-world-v1",
    "basemapRevision": "tokyo-kanagawa-mainland-v2"
