{
  "schemaVersion": 1,
  "identity": {
    "worldId": "tokyo-kanagawa-world",
    "artifactWorldId": "JP_TOKYO_KANAGAWA_MAINLAND",
    "manifestId": "local.tokyo-kanagawa-open-world",
    "name": "Tokyo–Kanagawa Open World",
