{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-world.local/contracts/world-definition/v1",
  "title": "Open World Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "tileViews", "map", "demand", "runtime", "release"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldId", "artifactWorldId", "manifestId", "name", "description", "version", "author", "compatibilityLineage"],
      "properties": {
        "worldId": { "$ref": "#/$defs/stableId" },
        "artifactWorldId": { "$ref": "#/$defs/stableId" },
        "manifestId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "author": { "type": "string", "minLength": 1 },
        "compatibilityLineage": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "tileViews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "initialTileId"],
      "properties": {
        "catalog": { "$ref": "#/$defs/relativeJsonPath" },
        "initialTileId": { "$ref": "#/$defs/stableId" },
        "boundaryOverlay": { "$ref": "#/$defs/relativeJsonPath" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLock", "profile", "basemapRevision"],
      "properties": {
        "sourceLock": { "$ref": "#/$defs/relativeJsonPath" },
        "profile": { "$ref": "#/$defs/stableId" },
        "nativeParkSourceLayer": { "enum": ["parks", "landuse"] },
        "worldVegetation": { "enum": ["modis-igbp-2023-v1"] },
        "basemapRevision": { "$ref": "#/$defs/stableId" }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "definition", "routingProfile", "nativePopPrefixes", "crossPopPrefixes"],
      "properties": {
        "adapter": { "enum": ["lodes-us", "estat-japan"] },
        "definition": { "$ref": "#/$defs/relativeJsonPath" },
        "routingProfile": { "$ref": "#/$defs/stableId" },
        "nativePopPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "crossPopPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageNamespace", "tileServerPort", "tileBaseGlobal", "diagnosticNamespace", "healthTile", "requiredHostCapabilities"],
      "properties": {
        "storageNamespace": { "$ref": "#/$defs/stableId" },
        "tileServerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "tileBaseGlobal": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "diagnosticNamespace": { "$ref": "#/$defs/stableId" },
        "healthTile": { "type": "string", "pattern": "^[A-Za-z0-9_-]+/[0-9]+/[0-9]+/[0-9]+\\.mvt(?:\\?.*)?$" },
        "requiredHostCapabilities": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformCompatibility", "artifactSelection", "artifactLayout"],
      "properties": {
        "platformCompatibility": { "type": "string", "minLength": 1 },
        "artifactSelection": { "enum": ["explicit"] },
        "artifactLayout": { "enum": ["split-map-demand-v1", "packaged-tile-directories-v1"] }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativeJsonPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:geo)?json$" }
  }
}
