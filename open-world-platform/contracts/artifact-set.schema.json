{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-world.local/contracts/artifact-set/v1",
  "title": "Open World Artifact Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactSetId", "worldId", "worldDefinitionHash", "platformRelease", "mapCreatorRevision", "sources", "tiles", "reports", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactSetId": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "worldId": { "type": "string", "minLength": 1 },
    "worldDefinitionHash": { "$ref": "#/$defs/hash" },
    "platformRelease": { "type": "string", "minLength": 1 },
    "mapCreatorRevision": { "type": "string", "minLength": 1 },
    "parentArtifactSetId": { "type": ["string", "null"], "pattern": "^sha256-[a-f0-9]{64}$" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" } },
    "tiles": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" }, "minItems": 1 },
    "reports": { "type": "array", "items": { "$ref": "#/$defs/hashedPath" } },
    "validation": {
      "type": "object",
      "additionalProperties": { "enum": ["passed", "not-applicable"] },
      "required": ["schema", "hashes", "mass", "routing", "reproducibility"]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
