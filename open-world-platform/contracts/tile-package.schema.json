{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-world.local/contracts/tile-package/v1",
  "title": "Open World Tile Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "worldId", "tileId", "gameCityCode", "capabilities", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "worldId": { "type": "string", "minLength": 1 },
    "tileId": { "type": "string", "minLength": 1 },
    "gameCityCode": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "enum": ["map", "demand", "roads", "route-paths"] }, "uniqueItems": true },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
