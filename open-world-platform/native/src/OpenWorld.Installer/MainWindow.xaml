<Window x:Class="OpenWorld.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subway Builder Open World Setup"
        Width="760" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12" UseLayoutRounding="True">
    <Grid x:Name="RootLayout" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="24,15,24,12">
                <TextBlock x:Name="PageTitleText" Text="Install Subway Builder Open World"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <TextBlock x:Name="PageSubtitleText" Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,16">
            <Grid x:Name="ReviewView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Header="World">
                    <Grid Margin="12,8,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Install" VerticalAlignment="Center" />
                        <ComboBox x:Name="WorldSelector" Grid.Column="1" SelectionChanged="WorldSelector_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Product.Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Disk space">
                    <Grid Margin="12,8,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Download" />
                            <TextBlock x:Name="DownloadSizeText" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Installed" />
                            <TextBlock x:Name="InstalledSizeText" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Free space required" />
                            <TextBlock x:Name="RequiredSizeText" Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="4" Header="Install locations">
                    <Grid Margin="12,8,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Application" Margin="0,2,12,4" />
                        <TextBlock x:Name="ProductPathText" Grid.Column="1" Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="Mod" Margin="0,2,12,4" />
                        <TextBlock x:Name="ModPathText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="Map data" Margin="0,2,12,4" />
                        <TextBlock x:Name="DataRootPathText" Grid.Row="2" Grid.Column="1" Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
                        <Expander Grid.Row="3" Grid.Column="1" Margin="0,3,0,0">
                            <Expander.Header>
                                <TextBlock x:Name="DataDirectoriesHeader" />
                            </Expander.Header>
                            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                    BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    Margin="0,6,0,0" Height="88">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DestinationList" Margin="8,5">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Publisher" FontWeight="SemiBold" />
                        <TextBlock x:Name="PublisherText" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Local tile server" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServerAddressText" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="ProgressView" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProgressSummaryText" Text="Preparing installation" FontSize="14" FontWeight="SemiBold" />
                <ProgressBar x:Name="OverallProgress" Grid.Row="2" Height="18" Minimum="0" Maximum="100" />
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressItemText" Text="Preparing" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" Margin="16,0,0,0" />
                </Grid>
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressBytesText" />
                    <TextBlock x:Name="ProgressCountText" Grid.Column="1" />
                </Grid>
                <Grid Grid.Row="5" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RateText" />
                    <TextBlock x:Name="EtaText" Grid.Column="1" />
                </Grid>
                <TextBlock x:Name="FailureText" Grid.Row="6" Foreground="#C42B1C"
                           TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeText" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <StackPanel x:Name="ReviewButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallButton" Content="Install" Click="Install_Click" IsDefault="True" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <Button x:Name="ProgressCancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click"
                        IsCancel="True" Visibility="Collapsed" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
