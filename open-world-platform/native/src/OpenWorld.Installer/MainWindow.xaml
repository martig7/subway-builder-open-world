<Window x:Class="OpenWorld.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northeast Corridor Open World setup"
        Width="980" Height="700" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource RailPaper}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Grid x:Name="RootLayout" Background="{StaticResource RailPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource RailNavy}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="42,27,20,20">
                <TextBlock Text="Northeast Corridor" Foreground="White" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Open World installer" Foreground="#B9C8D1" FontSize="17" Margin="1,4,0,0" />
            </StackPanel>
            <Grid Grid.Column="1" Margin="10,38,42,0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ReviewSignal" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SignalAmber}" />
                    <Border Grid.Column="1" Height="2" Background="#536B7A" VerticalAlignment="Center" />
                    <Border x:Name="DownloadSignal" Grid.Column="2" Width="18" Height="18" CornerRadius="9" BorderBrush="#78909D" BorderThickness="2" />
                    <Border Grid.Column="3" Height="2" Background="#536B7A" VerticalAlignment="Center" />
                    <Border x:Name="InstallSignal" Grid.Column="4" Width="18" Height="18" CornerRadius="9" BorderBrush="#78909D" BorderThickness="2" />
                    <Border Grid.Column="5" Height="2" Background="#536B7A" VerticalAlignment="Center" />
                    <Border x:Name="ReadySignal" Grid.Column="6" Width="18" Height="18" CornerRadius="9" BorderBrush="#78909D" BorderThickness="2" />
                </Grid>
                <Grid Grid.Row="1" Margin="-8,1,-8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Review" Foreground="White" FontSize="12" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="Download" Foreground="#AFC0C9" FontSize="12" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Install" Foreground="#AFC0C9" FontSize="12" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Ready" Foreground="#AFC0C9" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="42,32,42,26">
            <Grid x:Name="ReviewView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Before anything changes" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource RailNavy}" />
                            <Border Background="#F4E5C7" BorderBrush="#D6AD65" BorderThickness="1" Margin="16,3,0,0" Padding="9,4" VerticalAlignment="Top" CornerRadius="3">
                                <TextBlock Text="Self-signed release" Foreground="#6B4A13" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Review the measured size and installation locations. Setup starts only when you choose Install."
                                   FontSize="15" Foreground="{StaticResource RailSteel}" TextWrapping="Wrap" Margin="0,8,20,24" MaxWidth="620" />

                        <Grid Margin="0,0,12,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Download" Foreground="{StaticResource RailSteel}" FontSize="13" />
                                <TextBlock x:Name="DownloadSizeText" Foreground="{StaticResource RailNavy}" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource LineBrush}" />
                            <StackPanel Grid.Column="2" Margin="18,0">
                                <TextBlock Text="Installed" Foreground="{StaticResource RailSteel}" FontSize="13" />
                                <TextBlock x:Name="InstalledSizeText" Foreground="{StaticResource RailNavy}" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="3" Background="{StaticResource LineBrush}" />
                            <StackPanel Grid.Column="4" Margin="18,0,0,0">
                                <TextBlock Text="Free required" Foreground="{StaticResource RailSteel}" FontSize="13" />
                                <TextBlock x:Name="RequiredSizeText" Foreground="{StaticResource SignalAmber}" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Installation locations" Foreground="{StaticResource RailNavy}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProductPathText" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="#334B5A" Margin="0,9,12,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="ModPathText" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="#334B5A" Margin="0,6,12,0" TextWrapping="Wrap" />
                        <Expander Margin="0,8,12,0" Foreground="{StaticResource RailNavy}">
                            <Expander.Header>
                                <TextBlock x:Name="DataDirectoriesHeader" FontSize="13" FontWeight="SemiBold" />
                            </Expander.Header>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Margin="0,8,0,0" MaxHeight="155">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="DestinationList" Margin="12,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#405864" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Background="#E6ECEF" BorderBrush="#C3CED4" BorderThickness="1" Padding="24,22" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Release details" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource RailNavy}" />
                        <TextBlock x:Name="VersionText" FontSize="14" Foreground="{StaticResource RailSteel}" Margin="0,10,0,0" />
                        <TextBlock x:Name="GameVersionText" FontSize="14" Foreground="{StaticResource RailSteel}" Margin="0,5,0,0" />
                        <Border Background="#CAD6DB" Height="1" Margin="0,20" />
                        <TextBlock Text="Local tile server" FontSize="13" Foreground="{StaticResource RailSteel}" />
                        <TextBlock x:Name="ServerAddressText" FontFamily="Cascadia Mono, Consolas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource RailNavy}" Margin="0,4,0,0" />
                        <Border Background="#CAD6DB" Height="1" Margin="0,20" />
                        <TextBlock Text="Setup sequence" FontSize="13" Foreground="{StaticResource RailSteel}" />
                        <TextBlock Text="Download and verify release files" FontSize="14" Foreground="{StaticResource RailNavy}" Margin="0,8,0,0" />
                        <TextBlock Text="Install the mod and 34 data packages" FontSize="14" Foreground="{StaticResource RailNavy}" Margin="0,7,0,0" />
                        <TextBlock Text="Start and test the tile server" FontSize="14" Foreground="{StaticResource RailNavy}" Margin="0,7,0,0" />
                        <TextBlock x:Name="PreviewNotice" Text="Development preview — final release measurements will come from the signed manifest."
                                   Foreground="#795814" TextWrapping="Wrap" FontSize="12.5" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ProgressView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="20,0,54,0">
                    <TextBlock x:Name="ProgressSummaryText" Text="Downloading release files" Foreground="{StaticResource RailNavy}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressItemText" Text="Preparing…" Foreground="{StaticResource RailSteel}" FontSize="15" Margin="0,8,0,22" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="OverallProgress" Height="12" Minimum="0" Maximum="100" Foreground="{StaticResource SignalAmber}" Background="#D8E0E4" BorderThickness="0" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressBytesText" Foreground="{StaticResource RailSteel}" FontSize="13" />
                        <TextBlock x:Name="ProgressCountText" Grid.Column="1" Foreground="{StaticResource RailSteel}" FontSize="13" />
                    </Grid>
                    <Border Background="#D8E0E4" Height="1" Margin="0,28,0,20" />
                    <TextBlock x:Name="ProgressDetailText" Text="Files are verified before they replace any installed content."
                               Foreground="#405864" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="FailureText" Foreground="#A12A2A" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource RailNavy}" Padding="34" CornerRadius="4">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="White" FontSize="64" FontWeight="SemiBold" />
                        <TextBlock Text="overall progress" Foreground="#AFC0C9" FontSize="14" Margin="2,-4,0,0" />
                        <Border Height="1" Background="#425867" Margin="0,28" />
                        <TextBlock x:Name="RateText" Text="Calculating transfer rate" Foreground="#D7E0E5" FontSize="14" />
                        <TextBlock x:Name="EtaText" Text="" Foreground="#AFC0C9" FontSize="13" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="42,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="SourceButton" Content="View source" Click="Source_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource RailSteel}" Padding="0" MinWidth="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Close" Click="Cancel_Click" Margin="0,0,12,0" Background="#E8EDF0" BorderBrush="#B7C4CB" Foreground="{StaticResource RailNavy}" />
                    <Button x:Name="InstallButton" Content="Preview progress" Click="Install_Click" Background="{StaticResource SignalAmber}" BorderBrush="#B97718" Foreground="#17232B" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
