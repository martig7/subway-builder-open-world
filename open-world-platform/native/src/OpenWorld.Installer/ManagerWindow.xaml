<Window x:Class="OpenWorld.Installer.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subway Builder Open World Manager"
        Width="760" Height="540" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12" UseLayoutRounding="True">
    <Grid x:Name="RootLayout" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="24,15,24,12">
                <TextBlock Text="Subway Builder Open World Manager" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Status">
                <Grid Margin="12,8,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#7A7A7A" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="Tile server" FontWeight="SemiBold" />
                    <TextBlock x:Name="ServerStatusText" Grid.Column="2" Text="Checking" />
                    <TextBlock x:Name="AddressText" Grid.Column="3" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Map data" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock x:Name="PackageStatusText" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Not checked" Margin="0,6,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Tile server">
                <StackPanel Orientation="Horizontal" Margin="12,9,12,11">
                    <Button x:Name="StartButton" Content="Start" Click="Start_Click" />
                    <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Margin="8,0,0,0" />
                    <Button x:Name="RestartButton" Content="Restart" Click="Restart_Click" Margin="8,0,0,0" />
                    <Button x:Name="VerifyButton" Content="Verify data" Click="Verify_Click" Margin="8,0,0,0" />
                    <Button x:Name="LogsButton" Content="Open logs" Click="Logs_Click" Margin="8,0,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="Maintenance">
                <Grid Margin="12,9,12,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RepairButton" Content="Repair" Click="Repair_Click" />
                    <Button x:Name="UpdatesButton" Grid.Column="1" Content="Check for updates" Click="Updates_Click" Margin="8,0,0,0" />
                    <Button x:Name="UninstallButton" Grid.Column="2" Content="Uninstall" Click="Uninstall_Click" Margin="8,0,0,0" />
                    <CheckBox x:Name="StartupCheckBox" Grid.Column="3" Content="Start tile server when I sign in"
                              Checked="Startup_Changed" Unchecked="Startup_Changed"
                              VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="6">
                <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Hidden" />
                <TextBlock x:Name="ActivityText" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeText" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Button Grid.Column="1" Content="Close" Click="Close_Click" VerticalAlignment="Center" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
