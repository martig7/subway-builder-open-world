<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <OpenWorldVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\VERSION'))</OpenWorldVersionFile>
    <Version>$([System.IO.File]::ReadAllText('$(OpenWorldVersionFile)').Trim())</Version>
  </PropertyGroup>
</Project>
