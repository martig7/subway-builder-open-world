{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subway-builder-open-world.local/schemas/common.schema.json",
  "$defs": {
    "tileId": {
      "type": "string",
      "enum": ["KCW", "KCE"]
    },
    "gatewayId": {
      "type": "string",
      "pattern": "^KCG_(NORTH|CENTRAL|SOUTH)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lonLat": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/lonLat" }
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "compressedBytes", "uncompressedBytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "compressedBytes": { "type": "integer", "minimum": 0 },
        "uncompressedBytes": { "type": "integer", "minimum": 0 },
        "contentType": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
